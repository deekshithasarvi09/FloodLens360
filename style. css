 body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333;
    text-align: center;
    padding: 50px;
}

.container {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    max-width: 600px;
    margin: auto;
}

h1 {
    color: #0066cc;
}

.status-box {
    margin-top: 20px;
    padding: 20px;
    background: #e6f2ff;
    border-radius: 8px;
}

button {
    background: #0066cc;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 15px;
}

button:hover {
    background: #004b99;
}
